# --- Database connection for `supabase db push` ---
#
# 1. Supabase dashboard -> "Connect" button -> "Session pooler" -> copy the URI.
#    Paste it below AS-IS, keeping the literal [YOUR-PASSWORD] placeholder.
#    (It already has the correct host/region for your project.)
#
# 2. Put your real database password (raw, NOT encoded) in SUPABASE_DB_PASSWORD.
#    The migrate script percent-encodes it and fills the placeholder for you,
#    so special characters like @ # ! are fine.

SUPABASE_DB_URL=postgresql://postgres.logahclvylgznosacgfq:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres
SUPABASE_DB_PASSWORD=
