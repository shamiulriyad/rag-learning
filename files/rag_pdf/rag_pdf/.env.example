# Get a key from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Step 1
PDF_PATH=data/sample.pdf

# Step 4 - chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Step 5 - embedding
# huggingface = local model, no API key, no quota (first run downloads the model).
# google      = Gemini embeddings; needs GOOGLE_API_KEY with embedding quota.
EMBEDDING_PROVIDER=huggingface
# huggingface: sentence-transformers/all-MiniLM-L6-v2 (small, 384d) or
#              BAAI/bge-m3 (2.3GB download, 1024d, multilingual, stronger)
# google:      models/gemini-embedding-001
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Leave EMBEDDING_DIM empty to auto-detect the real vector size (recommended)
EMBEDDING_DIM=

# Step 6 - Qdrant
# Option A: Qdrant server (docker run -p 6333:6333 qdrant/qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Option B: no server, local on-disk file. Set this and QDRANT_URL is ignored.
QDRANT_PATH=
COLLECTION_NAME=pdf_rag

# Step 9 - retrieval
TOP_K=4

# Step 10 - Gemini
LLM_MODEL=gemini-2.5-flash
TEMPERATURE=0.2
