# URL of the Python FastAPI RAG service
RAG_SERVICE_URL=http://localhost:8000

# Where the React app runs (used for CORS)
FRONTEND_URL=http://localhost:5173

# Dev only: set to true to allow /api/chat without a Supabase login.
# Answers still work; chat history is not saved. Leave false in production.
ALLOW_ANONYMOUS=false

# Supabase (optional - leave blank to skip persistence + auth)
# Use the API URL: https://<project-ref>.supabase.co  (NOT the dashboard URL)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# service_role key (Settings -> API). Backend-only secret. Enables sign-up via
# the admin API so no confirmation email is sent. Never expose this to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
