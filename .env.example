# Copy to .env in your project folder (next to rag-kit.toml) and fill in.
# Never commit .env.
# Relative paths below are resolved from the project folder, not the shell's
# current directory.

# --- Gemini (answer generation; also embeddings if EMBEDDING_PROVIDER=google) ---
GOOGLE_API_KEY=your-gemini-api-key
LLM_MODEL=gemini-2.5-flash
TEMPERATURE=0.2

# --- Default file for `rag-kit ingest` with no arguments ---
PDF_PATH=data/sample.pdf
# Only for PDFs whose text extracts as scrambled glyphs (see rag_kit/pdf_font_repair.py).
# The bundled -Free-English-Grammar.pdf needs true.
PDF_FONT_REPAIR=false

# --- Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Embeddings ---
# huggingface = local model, no key needed. BAAI/bge-m3 produces 1024-dim vectors
# and matches the existing pdf_rag collection. Changing the model requires a new
# COLLECTION_NAME or `ingest --recreate`.
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=BAAI/bge-m3
# Leave empty to detect the dimension from the model.
EMBEDDING_DIM=

# --- Qdrant: set QDRANT_PATH for embedded local storage, or QDRANT_URL for a server ---
QDRANT_PATH=qdrant_data
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
COLLECTION_NAME=pdf_rag

# --- Retrieval ---
TOP_K=4
# Drop chunks scoring below this (cosine similarity). Empty = keep all.
MIN_SCORE=
